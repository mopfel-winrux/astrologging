D02","src":"ADD","t":"G","ra":358.0487,"dec":11.4697,"con":"Peg","mag":14.6,"magb":1,"maj":0.91,"min":0.74,"hub":"E-S0","s":"NGC7774 NED02 | PGC 93142 | UGC 12819 NED02"},{"id":"NGC7783 NED01","n":"NGC7783 NED01","src":"ADD","t":"G","ra":358.542,"dec":0.3829,"con":"Psc","mag":14.03,"magb":1,"maj":1.55,"min":0.72,"pa":109.0,"sb":23.67,"hub":"S0","notes":"Called 'NGC 7783a'in MCG.  Component 'a)' in UGC notes.","s":"NGC7783 NED01 | PGC 72803 | UGC 12837 NED01"},{"id":"NGC7783 NED02","n":"NGC7783 NED02","src":"ADD","t":"G","ra":358.5503,"dec":0.377,"con":"Psc","mag":15.03,"magb":1,"maj":0.83,"min":0.51,"pa":153.0,"sb":23.33,"hub":"E-S0","notes":"Called 'NGC 7783b'in MCG.  Component 'b)' in UGC notes.","s":"NGC7783 NED02 | PGC 72808 | UGC 12837 NED02"},{"id":"B001","n":"B 1","src":"B","t":"DrkN","ra":53.2375,"dec":31.15,"maj":30.0,"notes":"Large, indefinite","con":"Per","s":"B 1 | Barnard 1"},{"id":"B002","n":"B 2","src":"B","t":"DrkN","ra":53.3792,"dec":32.3167,"maj":20.0,"notes":"Indefinite; elongated SE and NW","con":"Per","s":"B 2 | Barnard 2"},{"id":"B003","n":"B 3","src":"B","t":"DrkN","ra":55.0042,"dec":31.9667,"maj":20.0,"notes":"Irregular, dark space in nebula; curved, bright strip of nebulosity in SW side","con":"Per","s":"B 3 | Barnard 3"},{"id":"B004","n":"B 4","src":"B","t":"DrkN","ra":56.0083,"dec":31.7833,"notes":"Very large; indefinite","con":"Per","s":"B 4 | Barnard 4"},{"id":"B005","n":"B 5","src":"B","t":"DrkN","ra":56.9708,"dec":32.8833,"maj":60.0,"notes":"Indefinite; elongated NE and SW; Eta Persei (BD +32 667, mag 5.8) near NE side","con":"Per","s":"B 5 | Barnard 5"},{"id":"B006","n":"B 6","src":"B","t":"DrkN","ra":59.0958,"dec":56.1167,"notes":"Round; indefinite","con":"Cam","s":"B 6 | Barnard 6"},{"id":"B007","n":"B 7","src":"B","t":"DrkN","ra":64.3542,"dec":28.55,"notes":"Large, irregular, with brighter condensation (B 10) in SE part","con":"Tau","s":"B 7 | Barnard 7"},{"id":"B008","n":"B 8","src":"B","t":"DrkN","ra":64.4583,"dec":55.2333,"notes":"Center of a dark, irregular lane about 2.6 degrees long and 22' + or - across; very much like the dark lanes E. of Rho Ophiuchi","con":"Cam","s":"B 8 | Barnard 8"},{"id":"B009","n":"B 9","src":"B","t":"DrkN","ra":64.5,"dec":55.05,"notes":"Dark, irregular vacancy. This is the middle of a great vacancy extending east and west, the continuous part of which is 2.5 degrees long and about .5 degree wide. It really extends in a more or less broken form for about 6 degrees. There is a wide region extending south of it for a couple of degrees","con":"Cam","s":"B 9 | Barnard 9"},{"id":"B010","n":"B 10","src":"B","t":"DrkN","ra":64.6708,"dec":28.2667,"maj":8.0,"notes":"The brightest part of B 7","con":"Tau","s":"B 10 | Barnard 10"},{"id":"B011","n":"B 11","src":"B","t":"DrkN","ra":66.6542,"dec":55.0333,"notes":"East end of irregular lane, B 8","con":"Cam","s":"B 11 | Barnard 11"},{"id":"B012","n":"B 12","src":"B","t":"DrkN","ra":67.4458,"dec":54.2333,"maj":24.0,"notes":"Isolated dark spot SE of B 11; irregularly round with extension E. from the NE side","con":"Cam","s":"B 12 | Barnard 12"},{"id":"B013","n":"B 13","src":"B","t":"DrkN","ra":67.825,"dec":54.8833,"maj":11.0,"notes":"Irregular; irregularly darker inside with a rather sharp, short, narrow extension toward the S.","con":"Cam","s":"B 13 | Barnard 13"},{"id":"B014","n":"B 14","src":"B","t":"DrkN","ra":69.9958,"dec":25.7333,"maj":3.0,"notes":"Very small, bright nebula; a bright spot in the dark nebula B 22. (Position given in Astrophysical Journal, 49, 14, (1919ApJ....49....1B) in error by 10m in right ascension.)","con":"Tau","s":"B 14 | Barnard 14"},{"id":"B015","n":"B 15","src":"B","t":"DrkN","ra":67.9833,"dec":46.6167,"maj":13.0,"notes":"Elliptical; diameter 15' x 10' slightly NW and SE. One of the finest examples of a dark object seen against the ordinary sky and away from the Milky Way. The background on which the stars shine is uniform over the entire plate. The object is in a region somewhat larger than itself, where there are r","con":"Per","s":"B 15 | Barnard 15"},{"id":"B016","n":"B 16","src":"B","t":"DrkN","ra":68.1083,"dec":46.6,"notes":"Very small; elongated N and S; close to SE edge of B 15","con":"Per","s":"B 16 | Barnard 16"},{"id":"B017","n":"B 17","src":"B","t":"DrkN","ra":68.125,"dec":46.5167,"notes":"Very small; elongated N and S; close to E edge of B 15","con":"Per","s":"B 17 | Barnard 17"},{"id":"B018","n":"B 18","src":"B","t":"DrkN","ra":67.8042,"dec":24.35,"maj":60.0,"notes":"Group of dark spots","con":"Tau","s":"B 18 | Barnard 18"},{"id":"B019","n":"B 19","src":"B","t":"DrkN","ra":68.25,"dec":26.2667,"maj":60.0,"notes":"Large, indefinite","con":"Tau","s":"B 19 | Barnard 19"},{"id":"B020","n":"B 20","src":"B","t":"DrkN","ra":69.2667,"dec":50.9667,"maj":60.0,"notes":"In S part of larger, relatively vacant area; this is the dark object mentioned by Espin in Monthly Notices, 58, 334, (1898MNRAS..58..334E). It is close north of a small group of faint stars and is 6' or 8' in diameter. In a somewhat larger vacant space (sic). It is not so definite as B 15.","con":"Per","s":"B 20 | Barnard 20"},{"id":"B021","n":"B 21","src":"B","t":"DrkN","ra":69.4875,"dec":55.35,"maj":10.0,"notes":"Indefinite; irregularly round","con":"Cam","s":"B 21 | Barnard 21"},{"id":"B022","n":"B 22","src":"B","t":"DrkN","ra":69.5,"dec":26.05,"maj":120.0,"notes":"Irregular; unequally dark; extended SE and NW; this is a very large region of obscure nebulosity with several darker streaks in it trending northwest. It is partly separated from another starless region lying about 2 degrees to the west and north. Near the middle of the first of these regions is a s","con":"Tau","s":"B 22 | Barnard 22"},{"id":"B023","n":"B 23","src":"B","t":"DrkN","ra":70.1375,"dec":29.8667,"maj":5.0,"notes":"Sharply pointed to the SE; BD +29 728 (magnitude 6.5) in N part","con":"Tau","s":"B 23 | Barnard 23"},{"id":"B024","n":"B 24","src":"B","t":"DrkN","ra":70.7208,"dec":29.7333,"maj":8.0,"notes":"Sharply pointed to the S","con":"Tau","s":"B 24 | Barnard 24"},{"id":"B025","n":"B 25","src":"B","t":"DrkN","ra":73.0167,"dec":46.0,"maj":8.0,"notes":"Irregularly round; a good example of a dark or more or less starless region","con":"Aur","s":"B 25 | Barnard 25"},{"id":"B026","n":"B 26","src":"B","t":"DrkN","ra":73.6583,"dec":30.6167,"maj":5.0,"notes":"Irregular; B 26, 27, 28 are close NW of BD +30 741 (mag 6.8), which is involved in feeble nebulosity","con":"Aur","s":"B 26 | Barnard 26"},{"id":"B027","n":"B 27","src":"B","t":"DrkN","ra":73.7833,"dec":30.55,"maj":5.0,"notes":"Irregular","con":"Aur","s":"B 27 | Barnard 27"},{"id":"B028","n":"B 28","src":"B","t":"DrkN","ra":73.9667,"dec":30.6333,"maj":4.0,"notes":"Irregular","con":"Aur","s":"B 28 | Barnard 28"},{"id":"B029","n":"B 29","src":"B","t":"DrkN","ra":76.5958,"dec":31.5833,"maj":10.0,"notes":"Round; indefinite","con":"Aur","s":"B 29 | Barnard 29"},{"id":"B030","n":"B 30","src":"B","t":"DrkN","ra":82.5667,"dec":12.7667,"maj":67.0,"notes":"Large dark area with few stars. There is a nebulous border, .5 degree wide, to the semi-vacant region extending 1 degree east and north from BD +12 803 (magnitude 7.0). Apparently this nebulous border extends many degrees east in a very diffused manner. There is a narrow dark lane extending south fr","con":"Ori","s":"B 30 | Barnard 30"},{"id":"B031","n":"B 31","src":"B","t":"DrkN","ra":83.0042,"dec":12.75,"maj":30.0,"notes":"Extended NE and SW; the E. and darkest part of B 30","con":"Ori","s":"B 31 | Barnard 31"},{"id":"B032","n":"B 32","src":"B","t":"DrkN","ra":83.0333,"dec":12.4167,"notes":"Dark projection from S. end of B 31 to the E.","con":"Ori","s":"B 32 | Barnard 32"},{"id":"B034","n":"B 34","src":"B","t":"DrkN","ra":85.875,"dec":32.6333,"maj":20.0,"notes":"Round; starless; indefinite","con":"Aur","s":"B 34 | Barnard 34"},{"id":"B035","n":"B 35","src":"B","t":"DrkN","ra":86.375,"dec":9.05,"maj":15.0,"notes":"Elongated E and W, 20'x10', with an extension SE; three small stars N of it","con":"Ori","s":"B 35 | Barnard 35"},{"id":"B036","n":"B 36","src":"B","t":"DrkN","ra":87.25,"dec":7.4167,"maj":120.0,"notes":"Irregular, narrow dark lane, NE and SW. The NE end connects brokenly with B 35. Well shown on Plate 21, Lick Observatory Publications, 11, 1913.","con":"Ori","s":"B 36 | Barnard 36"},{"id":"B037","n":"B 37","src":"B","t":"DrkN","ra":98.0,"dec":10.4667,"maj":175.0,"notes":"Irregular, semi-vacant region. This region is abruptly terminated on the S side by the nebulosity extending north from 15 Monocerotis. Its west side ends abruptly at 6h22m15s, +12 26' (1875.0). B 37, 38, and 39 are shown in Plates 28 and 29, Lick Observatory Publications, 11, 1913.","con":"Mon","s":"B 37 | Barnard 37"},{"id":"B038","n":"B 38","src":"B","t":"DrkN","ra":98.4208,"dec":11.0667,"maj":60.0,"notes":"Irregular vacancy. This seems to refer to a portion of B 37.","con":"Mon","s":"B 38 | Barnard 38"},{"id":"B039","n":"B 39","src":"B","t":"DrkN","ra":99.5083,"dec":10.3167,"notes":"Small, sharply defined, elongated spot in the nebulosity NW of 15 Monocerotis","con":"Mon","s":"B 39 | Barnard 39"},{"id":"B040","n":"B 40","src":"B","t":"DrkN","ra":243.6583,"dec":-18.9667,"maj":15.0,"notes":"Diffused dark spot; small star in it. This spot and B 41 are connected with the great nebula about Nu Scorpii and are doubtless denser opaque masses of the nebula. There is a larger dark region belonging to this same system in 16h23m, -19 30' (1875.0) (B 43), from which broken dark lanes somewhat li","con":"Sco","s":"B 40 | Barnard 40"},{"id":"B041","n":"B 41","src":"B","t":"DrkN","ra":245.5708,"dec":-19.6167,"maj":45.0,"notes":"Diffused dark spot","con":"Sco","s":"B 41 | Barnard 41"},{"id":"B042","n":"B 42","src":"B","t":"DrkN","ra":246.25,"dec":-23.4333,"notes":"Great nebula of Mu Ophiuchi; this object is put in the list because, though not wholly dark, it is partly so, and the evident obscuration produced by it puts it in the class for which the catalogue is made. The semi-vacant region in which this, the great nebula of Rho Ophiuchi, lies is about 3.5 deg","con":"Oph","s":"B 42 | Barnard 42"},{"id":"B043","n":"B 43","src":"B","t":"DrkN","ra":247.5,"dec":-19.7667,"notes":"Large dark region","con":"Oph","s":"B 43 | Barnard 43"},{"id":"B044","n":"B 44","src":"B","t":"DrkN","ra":250.0,"dec":-24.0667,"notes":"Dark lane E. from Rho Ophiuchi region. This is the middle of the main part of the great vacant lane that runs east from the region of Rho Ophiuchi. It is about 32' wide and has its beginning in a vacant area in which is the star 22 Scorpii (CD -24 12695, magnitude 5.5). It runs slightly northeast to","con":"Oph","s":"B 44 | Barnard 44"},{"id":"B045","n":"B 45","src":"B","t":"DrkN","ra":251.5,"dec":-21.5833,"maj":120.0,"notes":"Rather definite; Extended NE and SW with an irregular projection SW that connects it with the Rho Ophiuchi region. This appears to be a real, dark object.","con":"Oph","s":"B 45 | Barnard 45"},{"id":"B046","n":"B 46","src":"B","t":"DrkN","ra":254.3,"dec":-22.7167,"notes":"Irregular; definite; a string of small stars in the middle","con":"Oph","s":"B 46 | Barnard 46"},{"id":"B047","n":"B 47","src":"B","t":"DrkN","ra":254.925,"dec":-22.6333,"maj":15.0,"notes":"Irregular; definite; connected with B 51 by two sharp lanes","con":"Oph","s":"B 47 | Barnard 47"},{"id":"B048","n":"B 48","src":"B","t":"DrkN","ra":255.25,"dec":-40.6833,"maj":40.0,"notes":"Fairly well defined; 15' W and N of CD -40 11088 (magnitude 8); seems to be a real object","con":"Sco","s":"B 48 | Barnard 48"},{"id":"B049","n":"B 49","src":"B","t":"DrkN","ra":255.6625,"dec":-33.2667,"notes":"Small; close SE of and involving CD -33 11668 (magnitude 9.3).","con":"Sco","s":"B 49 | Barnard 49"},{"id":"B050","n":"B 50","src":"B","t":"DrkN","ra":255.725,"dec":-34.3833,"maj":15.0,"notes":"Large, irregular dark space; this is an irregular square, sharply defined on the east side and diffused on the west, where there are broken extensions for 30'. The star CD -34 11418 (magnitude 9.8) is near the middle. The stars CD -34 11422 (magnitude 9.8) and -34 11427 (magnitude 9.9) are on the ea","con":"Sco","s":"B 50 | Barnard 50"},{"id":"B051","n":"B 51","src":"B","t":"DrkN","ra":256.1833,"dec":-22.25,"maj":20.0,"notes":"Definite; one of a straggling group toward the eastern end of the dark lane from Rho Ophiuchi. Two irregular, dark lanes run west from it to B 47.","con":"Oph","s":"B 51 | Barnard 51"},{"id":"B053","n":"B 53","src":"B","t":"DrkN","ra":256.5,"dec":-33.5833,"maj":60.0,"notes":"Large; diffuse; extended N and S by 30'; curved toward the E at N end","con":"Sco","s":"B 53 | Barnard 53"},{"id":"B054","n":"B 54","src":"B","t":"DrkN","ra":256.6417,"dec":-34.25,"maj":5.0,"notes":"Small; round; close S. of magnitude 11 star","con":"Sco","s":"B 54 | Barnard 54"},{"id":"B055","n":"B 55","src":"B","t":"DrkN","ra":256.8875,"dec":-32.0,"maj":16.0,"notes":"Irregular; best defined SE.; CD -31 13582 (magnitude 8.9) near the center","con":"Sco","s":"B 55 | Barnard 55"},{"id":"B056","n":"B 56","src":"B","t":"DrkN","ra":257.2,"dec":-32.0833,"maj":3.0,"notes":"Small; close E of CD -31 13609 (magnitude 9.0). This seems to be a real object","con":"Sco","s":"B 56 | Barnard 56"},{"id":"B057","n":"B 57","src":"B","t":"DrkN","ra":257.0917,"dec":-22.8167,"maj":5.0,"notes":"Elongated NE and SW","con":"Oph","s":"B 57 | Barnard 57"},{"id":"B058","n":"B 58","src":"B","t":"DrkN","ra":257.8,"dec":-40.4,"maj":30.0,"notes":"Slightly extended N and S; a darker core at NE side","con":"Sco","s":"B 58 | Barnard 58"},{"id":"B059","n":"B 59","src":"B","t":"DrkN","ra":257.8458,"dec":-27.4833,"maj":60.0,"notes":"Sink hole; at the W end of a wide broken lane from B 78","con":"Oph","s":"B 59 | Barnard 59"},{"id":"B060","n":"B 60","src":"B","t":"DrkN","ra":257.9625,"dec":-22.4333,"maj":13.0,"notes":"Curved; extended NE and SW; this and B 57 are the most distinct of a group of dark spots SW of the square end of B 63.","con":"Oph","s":"B 60 | Barnard 60"},{"id":"B061","n":"B 61","src":"B","t":"DrkN","ra":258.7458,"dec":-20.4667,"notes":"Small; elongated E and W","con":"Oph","s":"B 61 | Barnard 61"},{"id":"B062","n":"B 62","src":"B","t":"DrkN","ra":259.05,"dec":-20.8667,"maj":19.0,"notes":"Very black in NW part; brightest of three stars in S part is BD -20 4690 (magnitude 9.4). Apparently a real object.","con":"Oph","s":"B 62 | Barnard 62"},{"id":"B063","n":"B 63","src":"B","t":"DrkN","ra":259.0,"dec":-21.4667,"maj":60.0,"notes":"Large, definite, curved figure, convex to N; the W end abrupt; 97' E and W, 19' wide","con":"Oph","s":"B 63 | Barnard 63"},{"id":"B064","n":"B 64","src":"B","t":"DrkN","ra":259.325,"dec":-18.4833,"notes":"Cometary; W of M 9; This object is somewhat cometary in form and has a very black core or head that sharply abuts against the thick stratum of stars; from this it spreads out into a large dark area with much dark detail, filling quite a space close southwest of M 9. It thus resembles a dark comet wi","con":"Oph","s":"B 64 | Barnard 64"},{"id":"B065","n":"B 65","src":"B","t":"DrkN","ra":259.9,"dec":-26.7,"maj":12.0,"notes":"Definite; elongated; 12' E and W","con":"Oph","s":"B 65 | Barnard 65"},{"id":"B066","n":"B 66","src":"B","t":"DrkN","ra":259.9875,"dec":-26.8833,"maj":8.0,"notes":"Definite; extended E and W; CD -26 12082 (magnitude 8.7) 5' from SE edge","con":"Oph","s":"B 66 | Barnard 66"},{"id":"B067","n":"B 67","src":"B","t":"DrkN","ra":260.2375,"dec":-26.85,"notes":"Definite; extended N and S; connects B 65 and 66","con":"Oph","s":"B 67 | Barnard 67"},{"id":"B068","n":"B 68","src":"B","t":"DrkN","ra":260.65,"dec":-23.7833,"maj":4.0,"notes":"Small; irregular; sharply defined; about 20' SW of B 72","con":"Oph","s":"B 68 | Barnard 68"},{"id":"B069","n":"B 69","src":"B","t":"DrkN","ra":260.7292,"dec":-23.9167,"notes":"Very small; irregular; sharply defined; extends N and S 4'","con":"Oph","s":"B 69 | Barnard 69"},{"id":"B070","n":"B 70","src":"B","t":"DrkN","ra":260.8833,"dec":-24.0333,"maj":4.0,"notes":"Sharply defined on W side","con":"Oph","s":"B 70 | Barnard 70"},{"id":"B071","n":"B 71","src":"B","t":"DrkN","ra":260.7583,"dec":-24.0,"maj":1.0,"notes":"Very small; extends 1.25', plus or minus","con":"Oph","s":"B 71 | Barnard 71"},{"id":"B072","n":"B 72","src":"B","t":"DrkN","ra":260.8958,"dec":-23.6167,"notes":"S-shaped; this is a striking object. It is a thin, curved black marking, the exact form of the letter S or the figure 5, as the imagination or point of view may dictate. The SE branch runs E for some distance passing close S of the star CD -23 13376 (magnitude 9.1). Its average thickness is about 2'","con":"Oph","s":"B 72 | Barnard 72"},{"id":"B073","n":"B 73","src":"B","t":"DrkN","ra":261.0333,"dec":-24.2833,"maj":1.0,"notes":"Very small; extended N and S 4'","con":"Oph","s":"B 73 | Barnard 73"},{"id":"B074","n":"B 74","src":"B","t":"DrkN","ra":261.2833,"dec":-24.2,"notes":"Slightly curved, extending 5' N from CD -24 13325 (magnitude 7.1). Sharpest on W and S sides","con":"Oph","s":"B 74 | Barnard 74"},{"id":"B075","n":"B 75","src":"B","t":"DrkN","ra":261.3208,"dec":-22.0167,"notes":"Curved and scalloped marking; BD -21 4598 (magnitude 8.3) on N edge (see Astrophysical Journal, 49, Plate II, 1(1919ApJ....49....1B))","con":"Oph","s":"B 75 | Barnard 75"},{"id":"B076","n":"B 76","src":"B","t":"DrkN","ra":261.25,"dec":-24.4,"notes":"Irregular, narrow black strip, 30' long E and W","con":"Oph","s":"B 76 | Barnard 76"},{"id":"B077","n":"B 77","src":"B","t":"DrkN","ra":262.0,"dec":-23.85,"maj":60.0,"notes":"Indefinite; connected by a vacant strip with B 78","con":"Oph","s":"B 77 | Barnard 77"},{"id":"B078","n":"B 78","src":"B","t":"DrkN","ra":263.0,"dec":-25.5833,"maj":180.0,"notes":"Very large; CD -26 12152 (magnitude 6.2) S of the middle. This vacant region, with its extension to the west running south of Theta Ophiuchi, is visible to the naked eye (see Popular Astronomy, 14, 580, 1906.)","con":"Oph","s":"B 78 | Barnard 78"},{"id":"B079","n":"B 79","src":"B","t":"DrkN","ra":264.3458,"dec":-19.6,"maj":30.0,"notes":"30' long SE and NW; narrow; sharply defined","con":"Oph","s":"B 79 | Barnard 79"},{"id":"B080","n":"B 80","src":"B","t":"DrkN","ra":264.425,"dec":-21.2667,"maj":2.0,"notes":"Small, definite; 3' x 1', SW and NE; close SE of BD -21 4674 (magnitude 8.1).","con":"Oph","s":"B 80 | Barnard 80"},{"id":"B081","n":"B 81","src":"B","t":"DrkN","ra":264.6333,"dec":-23.9167,"notes":"Very small; diffused; close SW of NGC 6401","con":"Oph","s":"B 81 | Barnard 81"},{"id":"B082","n":"B 82","src":"B","t":"DrkN","ra":264.6542,"dec":-23.7667,"notes":"Small; angular; well defined; 8' N of NGC 6401","con":"Oph","s":"B 82 | Barnard 82"},{"id":"B083","n":"B 83","src":"B","t":"DrkN","ra":264.7417,"dec":-24.1667,"maj":7.0,"notes":"Irregular; several small stars in it; narrow extension to the S","con":"Oph","s":"B 83 | Barnard 83"},{"id":"B084","n":"B 84","src":"B","t":"DrkN","ra":266.6042,"dec":-20.25,"notes":"Irregular looped figure; sharply defined; 22' long E and W; extension from it 20' toward the NW. BD -20 4865 (magnitude 8.2) near W end and BD -20 4860 (magnitude 9.1) near east end.","con":"Sgr","s":"B 84 | Barnard 84"},{"id":"B085","n":"B 85","src":"B","t":"DrkN","ra":270.6042,"dec":-23.0167,"notes":"Trifid nebula. This is the southern part of the Trifid nebula, NGC 6514. The dark markings in this nebula are too well known to insert in this catalogue.","con":"Sgr","s":"B 85 | Barnard 85"},{"id":"B086","n":"B 86","src":"B","t":"DrkN","ra":270.7542,"dec":-27.8667,"maj":5.0,"notes":"Diam. 5'; edge of diffused nebulosity. For the visual discovery of this object see Astronomische Nachrichten 108, 370, 1884.","con":"Sgr","s":"B 86 | Barnard 86"},{"id":"B087","n":"B 87","src":"B","t":"DrkN","ra":271.0417,"dec":-32.4833,"notes":"\"Parrot's head\"; CD -3 13679 (magnitude 9.3) central; several smaller stars in it CD -32 13666 (magnitude 9.6) on NW edge. CD -32 13687 (9.6) on SE edge.","con":"Sgr","s":"B 87 | Barnard 87"},{"id":"B088","n":"B 88","src":"B","t":"DrkN","ra":271.1458,"dec":-24.1,"maj":2.0,"notes":"Extended N and S; 2.7'x0.5'; in M8. There are other well-known markings in this nebula. This one and B 89 are given as illustrations of dark markings in the sky shown in relief against a nebulous or other luminous background. In this case there may be non-luminous opaque parts of the nebula itself.","con":"Sgr","s":"B 88 | Barnard 88"},{"id":"B089","n":"B 89","src":"B","t":"DrkN","ra":271.2458,"dec":-24.35,"maj":0.5,"notes":"Very small, diam. 0.5'; in M8","con":"Sgr","s":"B 89 | Barnard 89"},{"id":"B090","n":"B 90","src":"B","t":"DrkN","ra":272.5583,"dec":-28.2667,"maj":3.0,"notes":"Irregular; elongated; 3' N and S","con":"Sgr","s":"B 90 | Barnard 90"},{"id":"B091","n":"B 91","src":"B","t":"DrkN","ra":272.5292,"dec":-23.6833,"maj":5.0,"notes":"Diam. 5'; edge of diffused nebulosity","con":"Sgr","s":"B 91 | Barnard 91"},{"id":"B092","n":"B 92","src":"B","t":"DrkN","ra":273.8958,"dec":-18.2167,"maj":12.0,"notes":"Black spot; 15' N and S, 9' E and W","con":"Sgr","s":"B 92 | Barnard 92"},{"id":"B093","n":"B 93","src":"B","t":"DrkN","ra":274.2208,"dec":-18.05,"maj":2.0,"notes":"Cometary; a sharply defined black head 2' in diam., with a diffused tail 15' long running S; 20' NE of B 92","con":"Sgr","s":"B 93 | Barnard 93"},{"id":"B094","n":"B 94","src":"B","t":"DrkN","ra":276.4708,"dec":-10.65,"maj":15.0,"notes":"Roundish; diam. 15'; indefinite","con":"Sct","s":"B 94 | Barnard 94"},{"id":"B095","n":"B 95","src":"B","t":"DrkN","ra":276.3958,"dec":-11.7333,"maj":30.0,"notes":"Large; indefinite; diam. 30'; elongated","con":"Sct","s":"B 95 | Barnard 95"},{"id":"B096","n":"B 96","src":"B","t":"DrkN","ra":276.6,"dec":-10.2833,"notes":"Small; indefinite; elongated E and W","con":"Sct","s":"B 96 | Barnard 96"},{"id":"B097","n":"B 97","src":"B","t":"DrkN","ra":277.2708,"dec":-9.9167,"maj":60.0,"notes":"Irregular; not ver definite; diam. 1 degree","con":"Sct","s":"B 97 | Barnard 97"},{"id":"B098","n":"B 98","src":"B","t":"DrkN","ra":278.3167,"dec":-26.05,"maj":3.0,"notes":"Very small; black; sharply defined; diam . 3'","con":"Sgr","s":"B 98 | Barnard 98"},{"id":"B099","n":"B 99","src":"B","t":"DrkN","ra":278.3208,"dec":-21.4667,"maj":7.0,"notes":"Definite; 11' long E. and W., 3' wide; E end is the larger, with a faint star in it","con":"Sgr","s":"B 99 | Barnard 99"},{"id":"B100","n":"B 100","src":"B","t":"DrkN","ra":278.1708,"dec":-9.1333,"maj":16.0,"notes":"Definite; irregular; curved; 16' long NW and SE","con":"Sct","s":"B 100 | Barnard 100"},{"id":"B101","n":"B 101","src":"B","t":"DrkN","ra":278.1667,"dec":-8.8,"maj":8.0,"notes":"Definite; irregular; 13' long NE and SW; 4' wide; separated from B100 by a scattering of small stars","con":"Sct","s":"B 101 | Barnard 101"},{"id":"B102","n":"B 102","src":"B","t":"DrkN","ra":279.4208,"dec":-13.7333,"maj":5.0,"notes":"Rather definite; elongated NE and SW, 8' x 3'","con":"Sct","s":"B 102 | Barnard 102"},{"id":"B103","n":"B 103","src":"B","t":"DrkN","ra":279.8542,"dec":-6.6667,"maj":4.0,"notes":"Irregular; diam. 4'; one small star in it","con":"Sct","s":"B 103 | Barnard 103"},{"id":"B104","n":"B 104","src":"B","t":"DrkN","ra":281.8292,"dec":-4.5333,"maj":16.0,"notes":"Small, definite, caret-shaped object","con":"Sct","s":"B 104 | Barnard 104"},{"id":"B105","n":"B 105","src":"B","t":"DrkN","ra":281.9333,"dec":-6.9,"maj":0.5,"notes":"Very small; diam. .5'; close NE of BD -7 4710 (magnitude 8.9)","con":"Sct","s":"B 105 | Barnard 105"},{"id":"B106","n":"B 106","src":"B","t":"DrkN","ra":282.2042,"dec":-5.0667,"maj":2.0,"notes":"Diam. 2'; extended N and S; free of stars","con":"Sct","s":"B 106 | Barnard 106"},{"id":"B107","n":"B 107","src":"B","t":"DrkN","ra":282.375,"dec":-5.0,"maj":5.0,"notes":"Irregular; diam. 5'; free of stars","con":"Sct","s":"B 107 | Barnard 107"},{"id":"B108","n":"B 108","src":"B","t":"DrkN","ra":282.3917,"dec":-6.3,"maj":3.0,"notes":"Very small; diam. 3'; not black; two narrow diverging lanes extending to the N; some small stars in it","con":"Sct","s":"B 108 | Barnard 108"},{"id":"B109","n":"B 109","src":"B","t":"DrkN","ra":282.4,"dec":-7.55,"maj":0.7,"notes":"Irregular; diam. .7'; close E of BD -07 4726 (magnitude 8.0)","con":"Sct","s":"B 109 | Barnard 109"},{"id":"B110","n":"B 110","src":"B","t":"DrkN","ra":282.5333,"dec":-4.7833,"maj":11.0,"notes":"Irregular; diam. 11';","con":"Sct","s":"B 110 | Barnard 110"},{"id":"B111","n":"B 111","src":"B","t":"DrkN","ra":282.5,"dec":-4.95,"maj":120.0,"notes":"Region 2 degrees in diam., full of dark structures","con":"Sct","s":"B 111 | Barnard 111"},{"id":"B112","n":"B 112","src":"B","t":"DrkN","ra":282.7833,"dec":-6.6667,"maj":18.0,"notes":"Diffused dark region; diam. 18' plus or minus; perhaps due to want of stars","con":"Sct","s":"B 112 | Barnard 112"},{"id":"B113","n":"B 113","src":"B","t":"DrkN","ra":282.85,"dec":-4.3167,"maj":16.0,"notes":"Irregular; diam. 16'; small star in W part","con":"Sct","s":"B 113 | Barnard 113"},{"id":"B114","n":"B 114","src":"B","t":"DrkN","ra":283.2958,"dec":-6.9333,"maj":6.0,"notes":"Diam. 6'; BD -7 4754 (magnitude 9.2) near middle; BD -7 4755 (magnitude 9.1) on S edge","con":"Sct","s":"B 114 | Barnard 114"},{"id":"B115","n":"B 115","src":"B","t":"DrkN","ra":283.3292,"dec":-6.65,"maj":6.0,"notes":"Very small and black. Very narrow, running N and S for 7'; width 1.4'. It is in a small vacant region.","con":"Sct","s":"B 115 | Barnard 115"},{"id":"B116","n":"B 116","src":"B","t":"DrkN","ra":283.3833,"dec":-7.1667,"notes":"Narrow, semi-vacant region extending 20' S from BD -7 4755 (magnitude 9.1)","con":"Sct","s":"B 116 | Barnard 116"},{"id":"B117","n":"B 117","src":"B","t":"DrkN","ra":283.4292,"dec":-7.4,"maj":1.0,"notes":"Round; very black; diam. 1'; sharply defined","con":"Sct","s":"B 117 | Barnard 117"},{"id":"B118","n":"B 118","src":"B","t":"DrkN","ra":283.4792,"dec":-7.4333,"maj":2.0,"notes":"Definite; diam. 2'; more definite and blacker than B 117","con":"Sct","s":"B 118 | Barnard 118"},{"id":"B119","n":"B 119","src":"B","t":"DrkN","ra":283.65,"dec":-4.5333,"notes":"Very small; close NW of BD -4 4623 (magnitude 9.2)","con":"Sct","s":"B 119 | Barnard 119"},{"id":"B120","n":"B 120","src":"B","t":"DrkN","ra":283.7208,"dec":-4.5833,"notes":"Very small; close SE of BD -4 4623 (magnitude 9.2); E side bounded by a curve of very small stars","con":"Sct","s":"B 120 | Barnard 120"},{"id":"B121","n":"B 121","src":"B","t":"DrkN","ra":283.8542,"dec":-4.6,"notes":"Small dusky spot; magnitude 12 star in center","con":"Sct","s":"B 121 | Barnard 121"},{"id":"B122","n":"B 122","src":"B","t":"DrkN","ra":284.2,"dec":-4.75,"maj":4.0,"notes":"Small; diam. 4'; narrow extension 4' N","con":"Sct","s":"B 122 | Barnard 122"},{"id":"B123","n":"B 123","src":"B","t":"DrkN","ra":284.4125,"dec":-4.7167,"maj":1.5,"notes":"Roundish; diam. 1.5'; a narrow spur 4'-5' long from its NE edge; a narrow lane 18' long and 1.5' wide from its W side to the NW","con":"Sct","s":"B 123 | Barnard 123"},{"id":"B124","n":"B 124","src":"B","t":"DrkN","ra":284.4208,"dec":-4.35,"maj":3.0,"notes":"Small, dark spot; diam. 3'","con":"Sct","s":"B 124 | Barnard 124"},{"id":"B125","n":"B 125","src":"B","t":"DrkN","ra":284.5875,"dec":-4.3833,"maj":9.0,"notes":"Dark; lune shaped; 9' E and W; fairly well-defined on N border; some faint stars in it","con":"Sct","s":"B 125 | Barnard 125"},{"id":"B126","n":"B 126","src":"B","t":"DrkN","ra":284.7583,"dec":-4.5167,"maj":8.0,"notes":"Dusky; round; rather definite; diam. 8'","con":"Aql","s":"B 126 | Barnard 126"},{"id":"B127","n":"B 127","src":"B","t":"DrkN","ra":285.3792,"dec":-5.4333,"maj":4.5,"notes":"Irregular; diam. 4.5'","con":"Aql","s":"B 127 | Barnard 127"},{"id":"B128","n":"B 128","src":"B","t":"DrkN","ra":285.4167,"dec":-4.5667,"maj":10.0,"notes":"Irregular; dusky; fairly well defined; diam. 10'","con":"Aql","s":"B 128 | Barnard 128"},{"id":"B129","n":"B 129","src":"B","t":"DrkN","ra":285.5167,"dec":-5.3,"maj":5.0,"notes":"Very black; sharply defined; diam. 5